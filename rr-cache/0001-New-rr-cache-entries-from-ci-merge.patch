+static int qcom_pas_shutdown_poll_decrypt(struct qcom_pas *pas)
+{
+	unsigned int retry_num = 50;
+	int ret;
+
+	do {
+		msleep(QCOM_PAS_DECRYPT_SHUTDOWN_DELAY_MS);
+		ret = qcom_pas_shutdown(pas->pas_id);
+	} while (ret == -EINVAL && --retry_num);
+
+	return ret;
+}
